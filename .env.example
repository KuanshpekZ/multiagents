# Скопируйте этот файл в .env и впишите свой ключ. Файл .env в git не попадает.
# Подходит любой OpenAI-совместимый API с поддержкой вызова инструментов (tool calling).

# Вариант 1: Groq (ключ: https://console.groq.com/keys). Проверено с этой моделью.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Вариант 2: Google Gemini (ключ: https://aistudio.google.com/apikey)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=gemini-3.8-flash

# Необязательные лимиты (значения по умолчанию)
# AGENT_MAX_STEPS=8
# AGENT_TIMEOUT_S=300
# RUN_TIMEOUT_S=900
# MAX_INCIDENTS=5
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=4
# ALERT_THRESHOLD=0.5
